<?xml version="1.0" encoding="UTF-8"?>
<!--
    ============================================================================
     Cope Nights - pom.xml
    ============================================================================
     Jump scares, Herobrine, Blood Moons and hordes.

     BUILD (IntelliJ): Maven tab -> CopeNights -> Lifecycle -> package
                       (CopeCore must have been "install"ed first, see CopeCore's README)
     OUTPUT:           target/CopeNights-<version>.jar

     WHY THESE CHOICES (same as every Cope plugin)
       * Spigot API 1.20.1: the oldest version we support. Anything that compiles here runs on
         Spigot, Paper, Purpur and Arclight from 1.20.1 up to the newest 1.21.x.
       * Java 17 bytecode: runs on Java 17 (MC 1.20 - 1.20.4) and Java 21 (MC 1.20.5+).
       * CopeCore is "provided": it's installed on the server as its own plugin, so it is NOT bundled.
         Colors, messages, menus, commands, regions... all come from it.
       * No shade plugin: Cope Nights doesn't bundle any library.
    ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>us.copestudios</groupId>
    <artifactId>copenights</artifactId>
    <version>0.0.87</version>
    <packaging>jar</packaging>

    <name>CopeNights</name>
    <description>Jump scares, Herobrine, Blood Moons and hordes.</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spigot.version>1.20.1-R0.1-SNAPSHOT</spigot.version>
        <copecore.version>1.1.0</copecore.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The server provides these: compiled against, never bundled. -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>${spigot.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>us.copestudios</groupId>
            <artifactId>copecore</artifactId>
            <version>${copecore.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>CopeNights-${project.version}</finalName>

        <resources>
            <!-- Only plugin.yml gets ${project.version} filled in. The other files are copied as-is,
                 so text like "${" inside a message can never be changed by Maven. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
